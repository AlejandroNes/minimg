{
  "name": "minimg",
  "private": true,
  "homepage": "https://nesvatek.com/products/minimg/",
  "version": "1.1.0",
  "description": "Optimización, conversión, redimensionado y marcas de agua para imágenes, sin conexión.",
  "author": "Nesvatek",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "npm run check:metadata && tsc -b && vite build",
    "preview": "vite preview",
    "check": "npm run check:metadata && tsc -b --pretty false",
    "check:metadata": "node scripts/check-metadata.mjs",
    "test:updater": "node --experimental-strip-types --test tests/updater.test.mjs",
    "tauri": "tauri",
    "test:stability": "node --experimental-strip-types --test tests/stability.test.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "license": "GPL-3.0-only"
}
